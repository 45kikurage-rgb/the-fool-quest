            <intent-filter><action android:name="android.intent.action.SEND" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="text/plain" /></intent-filter>
        </activity>
        <activity android:name=".PayFetchActivity" android:exported="false" android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".CalendarControlActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
