<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalendarRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:weightSum">7</item>
    </style>
    <style name="CalendarCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginRight">1px</item>
        <item name="android:layout_marginBottom">1px</item>
    </style>
    <style name="CalendarText">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/aru_widget_rounded</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">4dp</item>
        <item name="android:autoSizeMaxTextSize">11sp</item>
        <item name="android:autoSizeStepGranularity">0.5dp</item>
    </style>
    <style name="CalendarHeaderText" parent="CalendarDailyText">
        <item name="android:textSize">20dp</item>
    </style>
    <style name="CalendarDailyText" parent="CalendarText">
        <item name="android:autoSizeTextType">none</item>
    </style>
    <style name="CalendarDailyAmount" parent="CalendarDailyText">
        <item name="android:gravity">end|center_vertical</item>
    </style>
    <style name="CalendarCategory" parent="CalendarDailyText">
        <item name="android:layout_width">9dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
</resources>
