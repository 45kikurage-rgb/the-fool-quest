<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_day_root" style="@style/CalendarCell"
    android:orientation="vertical" android:paddingLeft="2dp" android:paddingRight="2dp"
    android:paddingTop="1dp" android:paddingBottom="1dp" android:background="#202020">
    <TextView android:id="@+id/calendar_day_number" style="@style/CalendarDailyText"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1.08" android:gravity="center" android:layout_marginBottom="2dp" />
    <!-- The order of four independent rows is specified in CalendarDayRows.java. -->
    <LinearLayout android:id="@+id/calendar_amount_rows"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="3.82" android:orientation="vertical" />
</LinearLayout>
