<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_day_root" style="@style/CalendarCell"
    android:orientation="vertical" android:paddingLeft="2dp" android:paddingRight="2dp"
    android:paddingTop="1dp" android:paddingBottom="1dp" android:background="#202020">
    <TextView android:id="@+id/calendar_day_number" style="@style/CalendarDailyText"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1.08" android:gravity="center" android:layout_marginBottom="2dp" />
    <TextView android:id="@+id/calendar_day_total" style="@style/CalendarDailyAmount"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.12" />
    <LinearLayout android:id="@+id/calendar_coupon_row"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.90"
        android:orientation="horizontal">
        <TextView android:id="@+id/calendar_coupon_label" style="@style/CalendarCategory"
            android:text="C" android:textColor="#63E09E" />
        <TextView android:id="@+id/calendar_day_coupon" style="@style/CalendarDailyAmount"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:textColor="#63E09E" />
    </LinearLayout>
    <LinearLayout android:id="@+id/calendar_tiktok_row"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.90"
        android:orientation="horizontal">
        <TextView android:id="@+id/calendar_tiktok_label" style="@style/CalendarCategory"
            android:text="T" android:textColor="#7FBAFF" />
        <TextView android:id="@+id/calendar_day_tiktok" style="@style/CalendarDailyAmount"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:textColor="#7FBAFF" />
    </LinearLayout>
</LinearLayout>
