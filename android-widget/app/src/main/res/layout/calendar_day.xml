<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_day_root" style="@style/CalendarCell"
    android:orientation="vertical" android:paddingLeft="2dp" android:paddingRight="2dp"
    android:paddingTop="1dp" android:paddingBottom="1dp" android:background="#202020">
    <!-- Top band: the date on the left; the rare daily loss rides in the
         top-right corner as a two-line block (see calendar_row_loss.xml),
         so it no longer reserves a full row in every cell. -->
    <LinearLayout android:id="@+id/calendar_day_top"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1.08" android:orientation="horizontal"
        android:layout_marginBottom="2dp">
        <TextView android:id="@+id/calendar_day_number" style="@style/CalendarDailyText"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="start|center_vertical" />
        <include layout="@layout/calendar_row_loss" />
    </LinearLayout>
    <!-- Daily row order is configured ONLY here. To reorder, move these three include lines. -->
    <LinearLayout android:id="@+id/calendar_amount_rows"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="3.82" android:orientation="vertical">
        <include layout="@layout/calendar_row_total" />
        <include layout="@layout/calendar_row_coupon" />
        <include layout="@layout/calendar_row_tiktok" />
    </LinearLayout>
</LinearLayout>
