<?xml version="1.0" encoding="utf-8"?>
<!-- Keep this weighted slot unchanged so Coupon/TikTok retain their positions.
     The one-pixel rule overlays the digits, so it consumes no row height.
     Code50: signed digits and their rule share one ink-cropped image. The
     stack retains the native text row's height plus one pixel of clearance,
     centered in the slot and one physical pixel up. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_total_slot"
    android:layout_width="match_parent" android:layout_height="9px"
    android:layout_weight="2.02" android:layout_marginBottom="-3px">
    <LinearLayout android:id="@+id/calendar_total_stack"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical" android:orientation="vertical" android:gravity="end"
        android:translationY="-1px">
        <FrameLayout android:id="@+id/calendar_total_digits"
            android:layout_width="wrap_content" android:layout_height="wrap_content">
            <ImageView android:id="@+id/calendar_total_image"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:scaleType="center"
                android:importantForAccessibility="yes" />
            <TextView android:id="@+id/calendar_day_total" style="@style/CalendarDailyAmount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textScaleX="@dimen/calendar_daily_total_width_scale"
                android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/calendar_total_rule" style="@style/CalendarDailyText"
                android:layout_width="wrap_content" android:layout_height="1px"
                android:layout_gravity="bottom|end" android:includeFontPadding="false"
                android:visibility="gone" android:importantForAccessibility="no" android:background="#FFFFFF" />
        </FrameLayout>
        <TextView android:id="@+id/calendar_total_unit" style="@style/CalendarDailyAmount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:visibility="gone" android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
