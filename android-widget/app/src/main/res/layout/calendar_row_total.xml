<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the weighted measurement unchanged: +3px height and -3px margin
     cancel even during LinearLayout's first measuring pass. C/T translations
     place the three visible numerical gaps exactly one physical pixel closer. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/calendar_day_total" style="@style/CalendarDailyAmount"
        android:layout_width="match_parent" android:layout_height="9px" android:layout_weight="1.12"
        android:layout_marginBottom="-9px"
        android:textScaleX="@dimen/calendar_daily_total_width_scale" />
