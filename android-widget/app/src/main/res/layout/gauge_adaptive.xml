<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/gauge_image" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:adjustViewBounds="false" android:scaleType="fitXY"
        android:importantForAccessibility="no"/>
    <TextView android:id="@+id/lap_label" android:layout_width="34dp"
        android:layout_height="wrap_content" android:minHeight="10dp"
        android:gravity="right|center_vertical" android:fontFamily="monospace"
        android:includeFontPadding="false" android:textSize="9dp"
        android:maxLines="1" android:singleLine="true" android:textDirection="ltr"
        android:importantForAccessibility="no"/>
</LinearLayout>
