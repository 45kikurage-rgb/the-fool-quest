<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:layout_gravity="center_vertical">
    <ImageView android:id="@+id/gauge_image" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:adjustViewBounds="false" android:scaleType="fitXY"
        android:importantForAccessibility="no"/>
    <!-- The bitmap's intrinsic width comes only from GaugePalette.LAP_LABEL_WIDTH_DP. -->
    <ImageView android:id="@+id/lap_label" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>
</LinearLayout>

