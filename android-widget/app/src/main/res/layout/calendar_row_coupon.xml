<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/calendar_coupon_row"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.90" android:layout_marginBottom="-2px"
        android:translationY="2px"
        android:orientation="horizontal">
        <TextView android:id="@+id/calendar_coupon_label" style="@style/CalendarCategory"
            android:text="C" android:textColor="#63E09E" />
        <TextView android:id="@+id/calendar_day_coupon" style="@style/CalendarDailyAmount"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:textColor="#63E09E" />
    </LinearLayout>
    <!-- One combined loss amount from both sources, positioned below both gross T and C rows. -->
