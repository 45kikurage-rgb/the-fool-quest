<?xml version="1.0" encoding="utf-8"?>
<!-- One combined loss amount from both sources. Losses are rare (about
     once a month), so instead of a full row at the bottom of every cell
     the loss is a compact two-line block in the top-right corner, next to
     the date: the label on the first line, the amount below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/calendar_loss_block"
        android:layout_width="wrap_content" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="end"
        android:visibility="invisible">
    <TextView android:id="@+id/calendar_loss_label" style="@style/CalendarDailyText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="end" android:text="損失" android:textColor="#FF6464" />
    <TextView android:id="@+id/calendar_day_loss" style="@style/CalendarDailyText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="end" android:textColor="#FF6464" android:contentDescription="当日の損失合計" />
</LinearLayout>
