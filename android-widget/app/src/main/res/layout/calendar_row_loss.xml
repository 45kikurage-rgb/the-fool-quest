<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/calendar_loss_row"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="0.90" android:layout_marginBottom="-2px" android:orientation="horizontal"
        android:visibility="invisible">
        <TextView android:id="@+id/calendar_loss_label" style="@style/CalendarCategory"
            android:layout_width="wrap_content" android:text="損失" android:textColor="#FF6464" />
        <TextView android:id="@+id/calendar_day_loss" style="@style/CalendarDailyAmount"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:textColor="#FF6464" android:contentDescription="当日の損失合計" />
    </LinearLayout>
