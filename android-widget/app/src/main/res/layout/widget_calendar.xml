<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#151515"
    android:padding="4dp" android:layoutDirection="ltr">
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="5dp" android:paddingRight="5dp">
        <TextView android:id="@+id/calendar_title" style="@style/CalendarText"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="start|center_vertical"
            android:text="2026年11月" android:textStyle="bold"
            android:autoSizeMaxTextSize="13sp" />
        <LinearLayout android:id="@+id/calendar_summary" android:layout_width="0dp"
            android:layout_weight="1.65" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="end|center_vertical">
            <TextView android:id="@+id/calendar_summary_label" style="@style/CalendarText"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:gravity="end|center_vertical"
                android:layout_marginRight="4dp" android:text="合計" />
            <TextView android:id="@+id/calendar_summary_amount" style="@style/CalendarAmount"
                android:layout_width="0dp" android:layout_weight="2"
                android:layout_height="match_parent" android:text="—" android:textStyle="bold"
                android:autoSizeMaxTextSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/calendar_grid"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:background="#E0E0E0"
        android:paddingTop="1px" android:paddingLeft="1px">
        <LinearLayout android:id="@+id/calendar_week_0" style="@style/CalendarRow" />
        <LinearLayout android:id="@+id/calendar_week_1" style="@style/CalendarRow" />
        <LinearLayout android:id="@+id/calendar_week_2" style="@style/CalendarRow" />
        <LinearLayout android:id="@+id/calendar_week_3" style="@style/CalendarRow" />
        <LinearLayout android:id="@+id/calendar_week_4" style="@style/CalendarRow" />
    </LinearLayout>
</LinearLayout>
