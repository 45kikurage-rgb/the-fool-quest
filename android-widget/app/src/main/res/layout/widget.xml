<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:layoutDirection="ltr">
<FrameLayout android:id="@+id/widget_panel" android:layout_width="match_parent" android:layout_height="match_parent">

<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
<LinearLayout android:id="@+id/row_total" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="100" android:gravity="center_vertical">
<TextView android:id="@+id/total_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="16" android:text="Total" android:gravity="left" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
<TextView android:id="@+id/total_current" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="29" android:text="—" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" android:paddingRight="2dp" />
<TextView android:id="@+id/total_slash" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="/" android:gravity="center" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
<TextView android:id="@+id/total_goal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="29" android:text="—" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" android:paddingRight="2dp" />
<TextView android:id="@+id/total_percent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="23" android:text="—%" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
</LinearLayout>
<FrameLayout android:id="@+id/total_gauge_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/row_tiktok" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="100" android:gravity="center_vertical">
<TextView android:id="@+id/tiktok_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="16" android:text="TikTok" android:gravity="left" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
<TextView android:id="@+id/tiktok_current" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="29" android:text="—" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" android:paddingRight="2dp" />
<TextView android:id="@+id/tiktok_slash" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="/" android:gravity="center" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
<TextView android:id="@+id/tiktok_goal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="29" android:text="—" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" android:paddingRight="2dp" />
<TextView android:id="@+id/tiktok_percent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="23" android:text="—%" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
</LinearLayout>
<FrameLayout android:id="@+id/tiktok_gauge_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/row_coupon" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="100" android:gravity="center_vertical">
<TextView android:id="@+id/coupon_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="16" android:text="Coupon" android:gravity="left" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
<TextView android:id="@+id/coupon_current" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="29" android:text="—" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" android:paddingRight="2dp" />
<TextView android:id="@+id/coupon_slash" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="/" android:gravity="center" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
<TextView android:id="@+id/coupon_goal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="29" android:text="—" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" android:paddingRight="2dp" />
<TextView android:id="@+id/coupon_percent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="23" android:text="—%" android:gravity="right" android:fontFamily="monospace" android:textSize="13dp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:textDirection="ltr" />
</LinearLayout>
<FrameLayout android:id="@+id/coupon_gauge_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp"/>
</LinearLayout>
<TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8dp" android:fontFamily="monospace" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:paddingTop="3dp"/>
</LinearLayout>
<ImageView android:id="@+id/edge_top" android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="top" android:importantForAccessibility="no"/>
<ImageView android:id="@+id/edge_bottom" android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:importantForAccessibility="no"/>
<ImageView android:id="@+id/edge_left" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="left" android:importantForAccessibility="no"/>
<ImageView android:id="@+id/edge_right" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="right" android:importantForAccessibility="no"/>
</FrameLayout>
</FrameLayout>
