<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_forecast" style="@style/CalendarCell"
    android:orientation="vertical" android:background="#202020"
    android:paddingLeft="2dp" android:paddingRight="2dp"
    android:paddingTop="2dp" android:paddingBottom="2dp"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/calendar_forecast_title" style="@style/CalendarDailyText"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="月末予想" />
    <LinearLayout android:id="@+id/calendar_forecast_values"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3"
        android:orientation="vertical">
        <TextView android:id="@+id/calendar_forecast_total" style="@style/CalendarDailyAmount"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/calendar_forecast_c_label" style="@style/CalendarCategory"
                android:text="C" android:textColor="#63E09E" />
            <TextView android:id="@+id/calendar_forecast_coupon" style="@style/CalendarDailyAmount"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:textColor="#63E09E" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/calendar_forecast_t_label" style="@style/CalendarCategory"
                android:text="T" android:textColor="#91BAFF" />
            <TextView android:id="@+id/calendar_forecast_tiktok" style="@style/CalendarDailyAmount"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:textColor="#91BAFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
